# Copy this file to mail.properties and fill in your own values.
# mail.properties is listed in .gitignore and must never be committed.
#
# Every value can also be set with an environment variable, which wins:
# MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM, MAIL_FROM_NAME

mail.host=smtp.example.com
mail.port=587
mail.starttls=true
mail.username=you@example.com
# For Gmail use an App Password, never your account password
mail.password=change-me

# Optional: sender shown to recipients (defaults to mail.username)
mail.from=
mail.from.name=
